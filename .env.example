# Hermes Forge - LLM configuration
# These are USER-facing variables. Fill in your own API key.
# Any OpenAI-compatible endpoint works (OpenRouter, Nous NIM, vLLM, etc.)
USER_LLM_BASE_URL=https://openrouter.ai/api/v1
USER_LLM_API_KEY=your-api-key-here
USER_LLM_MODEL=nousresearch/hermes-4-405b

# Optional tuning
USER_AGENT_SYSTEM=You are Hermes Forge, a powerful agentic assistant built on the Hermes model family.
USER_MAX_TOKENS=4096
USER_TEMPERATURE=0.7

# Server port
PORT=3001
